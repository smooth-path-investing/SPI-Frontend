# Production release mode.
# `npm run build` and `npm run build:prod` load this file.

# Host port published by the production frontend container.
FRONTEND_PROD_PORT=4173

# Not used in prod. The production image serves static assets directly.
DEV_PROXY_TARGET=

# Set these to your live API origin in the deployment platform unless the web tier proxies these paths.
VITE_STOCK_ASSETS_API_BASE_URL=https://api.smoothpathinvesting.com/
VITE_STOCK_FACTOR_COEFVEC_API_BASE_URL=https://api.smoothpathinvesting.com/
VITE_STOCK_FUNDAMENTAL_API_BASE_URL=https://api.smoothpathinvesting.com/

# Only needed if `src/API/fetchPerformance.ts` is used in production.
VITE_LOCAL_BACKEND_SERVER=https://api.smoothpathinvesting.com/

# Supabase (anon key is public / read-only by design). Frontend reads DB-driven
# stock lists directly (stock_factor_coefvec.invest_type + security_master).
# Mirror these in the Netlify site env.
VITE_SUPABASE_URL=https://hqxvqrhhpkytpqdpwqsp.supabase.co
